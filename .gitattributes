# Normalise line endings to LF in the repository itself.
#
# This matters specifically because this machine runs Windows with
# core.autocrlf=true. Without these rules a Windows checkout writes CRLF into
# the object store, and the first contributor on macOS or Linux sees a diff on
# every single line. Declaring the intent here makes checkouts identical
# everywhere regardless of the contributor's local autocrlf setting.

* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts stay LF. PowerShell 7 reads LF on Windows without
# complaint, and CI runs these on Linux -- pinning them to CRLF would send
# carriage returns into the Linux runner for no benefit.

# Never touch these: they are byte-exact formats, and running them through the
# text filter corrupts them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.bmp  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.jar  binary
*.aar  binary
*.so   binary
*.dex  binary
*.apk  binary
*.aab  binary
*.jks  binary
*.keystore binary
*.p12  binary
*.mp3  binary
*.mp4  binary
*.webm binary

# Generated files: keep them out of diffs and out of "language stats".
gradlew        text eol=lf
gradlew.bat    text eol=crlf
*.lock         -diff linguist-generated
gradle-wrapper.properties -diff linguist-generated
